{
  "name": "guilda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4000",
    "build": "next build",
    "start": "next start -p 4000",
    "lint": "eslint",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:schema": "npx --yes @better-auth/cli@latest generate --config src/lib/auth.ts --output src/db/schema/auth.ts --yes",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node --conditions=react-server --import=tsx scripts/seed.ts",
    "bootstrap:owner": "node --conditions=react-server --import=tsx scripts/bootstrap-owner.ts",
    "import:clients": "node --conditions=react-server --import=tsx scripts/import-clients.ts",
    "telegram:worker": "node --conditions=react-server --import=tsx scripts/telegram-worker.ts",
    "support:worker": "node --conditions=react-server --import=tsx scripts/support-worker.ts",
    "e2e:phase2": "node scripts/e2e-phase2.mjs",
    "e2e:phase3": "node scripts/e2e-phase3.mjs",
    "check:rls": "node scripts/check-rls.mjs",
    "check:support-schema": "node scripts/check-support-schema.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@xmldom/xmldom": "^0.9.12",
    "better-auth": "1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.23.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "node-forge": "^1.4.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.6.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.3.4",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "4.1.1",
    "xml-crypto": "^6.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/node-forge": "^1.3.14",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright": "^1.61.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5",
    "vitest": "^4.1.12",
    "xmllint-wasm": "^5.3.0"
  },
  "overrides": {
    "brace-expansion@^1": "^1.1.22",
    "brace-expansion@^5": "^5.0.13",
    "fast-uri": "^3.1.9",
    "source-map-js": "^1.2.2",
    "systeminformation": "^5.33.19",
    "vite": "^8.3.8"
  }
}
