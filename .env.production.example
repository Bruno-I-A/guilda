# Copie para .env ao lado do docker-compose.yml na VPS e preencha.

# Domínio público (Caddy emite o certificado TLS automaticamente)
DOMAIN=guilda.seudominio.com.br

# Senhas do Postgres (owner e role da aplicação)
POSTGRES_PASSWORD=troque-por-uma-senha-forte
APP_DB_PASSWORD=troque-por-outra-senha-forte

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-forte
# Gere com: openssl rand -base64 32. Usada apenas para cifrar Gov.br no Fluxo.
FLOW_SECRETS_KEY=

# Token entregue pelo @BotFather. Deixe vazio para manter a integração inativa.
TELEGRAM_BOT_TOKEN=
# Overrides opcionais; normalmente podem permanecer vazios.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# polling (padrão, recomendado) ou webhook (exige URL pública HTTPS)
TELEGRAM_UPDATE_MODE=polling

# App próprio em Meta for Developers. O verify token é um segredo aleatório
# definido por nós e informado também na configuração do webhook da Meta.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_GRAPH_API_VERSION=v24.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Gere com: openssl rand -base64 32. Perder exige reconectar os números.
WHATSAPP_TOKEN_KEY=

# IA para classificar informativos e preparar missões via Telegram.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
