# ── Banco de dados ──────────────────────────────────────────────
# Runtime da aplicação: role dedicado NÃO-superuser => RLS aplicado
DATABASE_URL=postgresql://guilda_app:guilda_app_dev@localhost:5432/guilda
# Migrations e seed: role owner das tabelas (drizzle-kit / scripts)
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guilda

# ── better-auth ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=troque-por-um-segredo-forte-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:4000

# ── Cofre do Fluxo Societário ───────────────────────────────────
# Chave AES-256 para cifrar credenciais Gov.br (openssl rand -base64 32).
# Sem ela, o Fluxo segue funcionando, mas não aceita armazenar a senha.
FLOW_SECRETS_KEY=

# WhatsApp Cloud API / coexistência: Atendimento e avisos da equipe (o Telegram
# saiu em 2026-11-24). Os botões dos modelos usam NEXT_PUBLIC_APP_URL (https).
# App Tech Provider aprovado da Shift. Ao assinar cada WABA, a Guilda deriva de
# BETTER_AUTH_URL o callback /api/atendimento/meta/webhook e o sobrescreve com o
# token abaixo. Nunca use o access token de um número como verify token.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
WHATSAPP_GRAPH_API_VERSION=v24.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Chave AES-256 para cifrar os access tokens por canal (openssl rand -base64 32).
WHATSAPP_TOKEN_KEY=

# ── IA para os informativos (painel e pedidos pelo WhatsApp) ────────────────
ANTHROPIC_API_KEY=
# Claude Sonnet; pode ser alterado sem rebuild.
ANTHROPIC_MODEL=claude-sonnet-5
# Triagem do Atendimento. "shadow": a IA le cada conversa nova e mostra o que faria,
# sem enviar nada ao cliente. Vazio ou "off": desligada (as mensagens nao vao a IA).
SUPPORT_AI_MODE=
# Espera, em segundos, o cliente terminar de escrever antes de a IA ler o turno.
SUPPORT_TRIAGE_DEBOUNCE_SECONDS=20

# Servico fiscal (notas de honorario). So no servico com GUILDA_SERVICE=fiscal:
# NFSE_CERT_PFX_BASE64=
# NFSE_CERT_PASSWORD=
# NFSE_AMBIENTE=            # vazio = producao restrita
# NFSE_LEIAUTE=             # vazio = automatico (NT 009 na producao a partir de 01/12/2026); nt004|nt009 forca
# No app e no servico fiscal (o mesmo valor, 32+ caracteres):
# FISCAL_SERVICE_TOKEN=
# So no app:
# FISCAL_SERVICE_URL=http://localhost:4100
# Transcrição dos áudios do Atendimento (2026-11-23). Sem a chave, o áudio só se ouve.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=
