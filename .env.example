# ── Banco de dados ──────────────────────────────────────────────
# Runtime da aplicação: role dedicado NÃO-superuser => RLS aplicado
DATABASE_URL=postgresql://guilda_app:guilda_app_dev@localhost:5432/guilda
# Migrations e seed: role owner das tabelas (drizzle-kit / scripts)
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/guilda

# ── better-auth ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=troque-por-um-segredo-forte-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:4000

# ── Telegram (opcional; sem token a Guilda continua funcionando) ───────────
# Crie o bot com @BotFather. O @username e o segredo do webhook são resolvidos
# automaticamente; estas duas variáveis só são necessárias para overrides.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
# polling (padrão, recomendado) ou webhook (exige URL pública HTTPS)
TELEGRAM_UPDATE_MODE=polling

# ── IA para classificar informativos recebidos pelo Telegram ────────────────
OPENAI_API_KEY=
# Modelo econômico para extração estruturada; pode ser alterado sem rebuild.
OPENAI_MODEL=gpt-5.6-luna
